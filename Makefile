GO ?= go

.PHONY: check
check:
	@test -z "$$($(GO)fmt -l .)" || { echo "gofmt 未通过："; $(GO)fmt -l .; exit 1; }
	# 三个组件都是独立 Go module，逐个执行完整质量门。
	$(GO) -C auth-server vet ./...
	$(GO) -C auth-server test ./...
	$(GO) -C auth-server build ./...
	$(GO) -C service-server vet ./...
	$(GO) -C service-server test ./...
	$(GO) -C service-server build ./...
	$(GO) -C e2e vet ./...
	$(GO) -C e2e test ./...
	$(GO) -C e2e build ./...
