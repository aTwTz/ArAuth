# e2e 专用环境（scripts/e2e.sh 经 docker compose --env-file 使用）。
# 全部是一次性 throwaway 值：独立 compose project（arauth-e2e）跑完即
# down -v 销毁。禁止把任何真实部署的凭据填进本文件，也禁止把本文件的值
# 用于任何真实部署。

POSTGRES_USER=arauth_e2e
POSTGRES_PASSWORD=arauth_e2e_throwaway_password
POSTGRES_DB=arauth_e2e

# e2e 用 Caddy 内网 CA 给 localhost 签证书（根证书由 e2e.sh 从容器取出供
# E2E 客户端信任，不用 InsecureSkipVerify）。
ARAUTH_DOMAIN=localhost
# rp.id = 父域（localhost 是开发豁免形态，DESIGN.md 第 8 节）；origins 显式
# 白名单。compose 会将它们映射为依赖方参考服务的 RP_ID/RP_ORIGINS。
ARAUTH_RPID=localhost
ARAUTH_RP_ORIGINS=https://localhost:18443

# 依赖方后端调内网 /exchange 的共享密钥（throwaway，仅本测试栈内有效）。
ARAUTH_EXCHANGE_API_KEY=e2e-throwaway-exchange-key

# TOTP 种子加密主密钥（固定 throwaway 样例，仅本测试栈内有效）。
ARAUTH_TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
