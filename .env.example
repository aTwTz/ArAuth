# arauth 环境变量样例。复制为 .env 后：docker compose 自动读取（全栈部署），
# 本机 go run/goose 需自行 export 或 source（开发）。
# 以下为纯本地开发值，非秘密；生产凭据绝不入库。

# ============ Postgres（开发库与生产容器共用） ============
POSTGRES_USER=arauth
POSTGRES_PASSWORD=arauth-dev
POSTGRES_DB=arauth
# 宿主机映射端口（只绑 127.0.0.1，供本机 goose/开发调试；生产可留默认）
POSTGRES_PORT=5432

# ============ 构建期 ============
# docker 构建期 Go 模块代理（非 ARAUTH_ 运行时配置）。默认官方代理；
# 受限网络（如国内直连 Docker Hub/官方代理不通）改为
# https://goproxy.cn,direct。
GOPROXY=https://proxy.golang.org,direct

# ============ 公共服务与身份（必填） ============
# Caddy 伺服与 ACME 签证书用的公共服务域名。变量名为兼容现有配置暂时保留，
# 并不表示浏览器会直连 arauth。本地自验填 localhost；公网填真实域名。
ARAUTH_DOMAIN=localhost

# 【必读】rp.id 必须填父域（如 arithmaton.com），填子域（含
# arauth.arithmaton.com）启动直接失败——rp.id 注册时定型、哈希进凭据、
# 终身不可改，设错 = 全员重注册，无迁移路径（DESIGN.md 第 8 节）。
ARAUTH_RPID=localhost

# WebAuthn origin 白名单（必填，逗号分隔，禁止通配）。compose 本地自验为
# https://localhost；生产 = https://<公共服务域名>，并与 RP_ORIGINS 保持一致。
ARAUTH_RP_ORIGINS=https://localhost

# Postgres 连接串（必填）。本机 go run/goose 用 localhost 形态；
# compose 内 arauth 由 compose 用 POSTGRES_* 现拼覆盖本项。
ARAUTH_DSN=postgres://arauth:arauth-dev@localhost:5432/arauth

# service-server 调内网 /exchange 的共享密钥（必填，服务器机密）。生产必须
# 换成高熵随机值（如 openssl rand -base64 32）；compose 会映射给 RP，无需另配。
ARAUTH_EXCHANGE_API_KEY=dev-exchange-key

# ============ TOTP 找回 ============
# 必填：base64 编码的 32 字节 AES-GCM 主密钥，只在数据库外保管和注入。
# 以下仅是开发样例；生产必须用 openssl rand -base64 32 重新生成并替换，
# 由部署平台的秘密管理机制保管，不得沿用样例或提交真实值。
ARAUTH_TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# 更换主密钥会使旧 TOTP 全部不可用；更换后须先用恢复码找回或重新完成
# 新鲜 WebAuthn 登录，再重新绑定。操作前确认这些登录/恢复路径仍可用。
ARAUTH_TOTP_KEY_VERSION=1          # 当前活跃主密钥版本
ARAUTH_TOTP_ISSUER=arauth          # 认证器中显示的发行方
ARAUTH_TOTP_SETUP_TTL=300          # 绑定 setup token 有效期（秒）
ARAUTH_TOTP_FRESH_SESSION_TTL=900  # 允许绑定/更换的新鲜 WebAuthn 会话窗口（秒）
ARAUTH_TOTP_FAILURE_WINDOW=300     # 按 recovery_id 计数的失败窗口（秒）
ARAUTH_TOTP_MAX_FAILURES=5         # 窗口内最大失败次数

# ============ 监听与部署形态 ============
# HTTP 监听地址（默认 :8080，一般无需改）
ARAUTH_ADDR=:8080

# 会话 cookie 的 Secure 属性（默认 true；仅本机 HTTP 开发允许 false，
# 生产必须 true——HTTPS 是硬前提，DESIGN.md 第 8 节）。compose 已强制 true。
ARAUTH_SESSION_COOKIE_SECURE=true

# 客户端 IP 是否取 X-Forwarded-For 末项（默认 false = 取 RemoteAddr）。
# 为 true 时 arauth 只能由会重写该头的可信 service-server 到达；compose 已
# 置 true，且 arauth/service-server 均不发布宿主端口。
ARAUTH_TRUST_PROXY_HEADERS=false

# ============ TTL（秒） ============
ARAUTH_CHALLENGE_TTL=300          # WebAuthn ceremony challenge 内存暂存（一次性）
ARAUTH_POW_CHALLENGE_TTL=300      # PoW challenge 存活（验一次即作废）
ARAUTH_SESSION_TTL=1209600        # 会话（14 天）
ARAUTH_EXCHANGE_CODE_TTL=300      # 一次性 exchange code
ARAUTH_RECOVERY_TOKEN_TTL=300     # 一次性恢复凭证
ARAUTH_PENDING_TTL=86400          # pending identity 等待恢复码确认的宽限（24 小时）

# ============ PoW ============
ARAUTH_POW_DIFFICULTY=21          # 初始难度（前缀零位数），必须落在下述区间内
ARAUTH_POW_MIN_DIFFICULTY=18      # 自适应区间下限
ARAUTH_POW_MAX_DIFFICULTY=24      # 自适应区间上限
ARAUTH_POW_ADAPTIVE_WINDOW=50     # 每集满这么多个验证结果评估一次升/降挡
ARAUTH_POW_ADAPTIVE_UP=0.5        # 失败率 ≥ 此值升一位（要求 0 < down < up < 1）
ARAUTH_POW_ADAPTIVE_DOWN=0.1      # 失败率 ≤ 此值降一位

# ============ 限流（per-IP 令牌桶） ============
ARAUTH_RATE_STRICT_RPS=1.0        # 严格档速率：注册系/两种恢复兑换/exchange/PoW 领取
ARAUTH_RATE_STRICT_BURST=8        # 严格档突发
ARAUTH_RATE_LENIENT_RPS=4.0       # 宽松档速率：登录端点
ARAUTH_RATE_LENIENT_BURST=16      # 宽松档突发

# ============ 可选加固（默认关，预计长期关） ============
# 打开后注册只接受带证书链的 attestation 格式（apple/android-key/packed），
# none 一律拒绝——会拒掉只回 none 的浏览器，牺牲可用性换设备背书。
ARAUTH_ATTESTATION_STRICT=false
